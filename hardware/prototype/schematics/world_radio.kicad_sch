	(text "With my particular TFT display, which is Chinese and \noff-brand, the wire mapping is as follows:\nGND -> GND\n3V3 -> VCC\nGPIO18/D18 -> SCK\nGPIO23/D23 -> SDA\nGPIO4/D4 -> RST/RESET\nGPIO2/D2 -> DC\nGPIO5/D5 -> CS"
		(exclude_from_sim no)
		(at 243.586 63.246 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "a429b658-1e12-4870-8247-061455bc50db")
	)
	(text "Note that my hardware is a TFT module\ndriven by a ST7789 controller,\nNOT an ILI9341, and only using 7 pins\nfor SPI & power. This symbol is incorrect\nbut just what happened to be in Kicad by default."
		(exclude_from_sim no)
		(at 199.136 118.618 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "b1640939-50d3-4ef2-bb3d-f34a4c7c125e")
	)
